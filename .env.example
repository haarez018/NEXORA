# Copy to .env.local. Blank optional values are allowed; never commit secrets.
# demo: public synthetic preview; operational: enables database-backed authentication.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
DATABASE_URL=
AUTH_SESSION_SECRET=
# Phase 1 deliberately rejects any other execution mode.
AI_PROVIDER=disabled
PAYMENTS_MODE=disabled
LOG_LEVEL=info

# PostgreSQL Docker Compose variables; choose your own values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional dedicated migrated database for transactional integration tests.
TEST_DATABASE_URL=

# Trusted local operator provisioning only; no browser registration or role selection.
PROVISION_EMAIL=
PROVISION_NAME=
PROVISION_PASSWORD=
PROVISION_ROLE=
PROVISION_ORG_SLUG=
PROVISION_ORG_NAME=

# Reserved future variables; not consumed or activated in Phase 1.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
PAYPAL_ENVIRONMENT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
EVIDENCE_STORAGE_PATH=
